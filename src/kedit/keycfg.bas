10  REM KEYCFG - KEDIT KEY SETUP
20  REM WRITES THE FILE KEYS (32 BYTES AT $300)
30  REM KEDIT READS IT AT START (BRUN KEDIT)
40  D$ =  CHR$ (4):N = 22:SP$ = "                                             "
50  DIM K(31),A(22),A$(22),G(22),E$(22),KC$(22),KD(22),IX(31),NC(22)
60  FOR I = 1 TO N: READ A(I),A$(I): NEXT
70  DATA 2,"왼쪽",21,"오른쪽",11,"위 줄",10,"아래 줄"
80  DATA 15,"줄 처음",14,"줄 끝",23,"앞 쪽",26,"다음 쪽"
90  DATA 20,"글 처음",5,"글 끝",19,"앞 글자 지움",4,"글자 지움"
100  DATA 24,"줄 끝까지 지움",25,"줄 지움",16,"줄 붙임",7,"줄 복사"
110  DATA 18,"줄 되돌림",6,"다시 찾기",17,"대소문자",9,"탭",12,"다시 그림",3,"문단 지움"
120  GOSUB 800
130  ONERR  GOTO 160
140  PRINT D$"BLOAD KEYS,A$300"
150  FOR J = 0 TO 31:K(J) =  PEEK (768 + J): NEXT J
155  B = 0: FOR J = 0 TO 31: IF K(J) > 31 THEN B = 1
157  NEXT J: IF B THEN GOSUB 800
160  POKE 216,0
170  I = 1:M$ = "":W = 0:MS = 0: GOSUB 1100: FOR J = 1 TO N:G(J) = 1: NEXT J
180  GOSUB 1200
200  GOSUB 1300
300  GOSUB 900
310  G(W) = 1:W = 0
320  IF C > 96 THEN C = C - 32
325  IF C = 21 OR C = 78 OR C = 32 THEN G(I) = 1:I = I + 1 - N * (I = N):G(I) = 1: GOTO 200
326  IF C = 8 OR C = 80 THEN G(I) = 1:I = I - 1 + N * (I = 1):G(I) = 1: GOTO 200
330  IF C < 32 THEN 400
335  IF C = 73 THEN C = 9: GOTO 410
360  IF C = 67 THEN GOSUB 750:M$ = "지웠습니다": GOTO 200
370  IF C = 82 THEN 600
380  IF C = 83 THEN 500
390  IF C = 81 THEN HOME : END
395  M$ = "쓸 수 없는 키": GOTO 200
400  IF C = 1 OR C = 8 OR C = 13 OR C = 27 THEN M$ = "^" +  CHR$ (64 + C) + " 는 고정 키": GOTO 200
410  O = K(C):K(C) = A(I):M$ = "^" +  CHR$ (64 + C) + " 로 정함":KD(I) = 1:G(I) = 1: IF O = A(I) THEN 200
420  FOR J = 1 TO N: IF A(J) = O THEN M$ = M$ + " (" + A$(J) + " 키 뺏음)":W = J:KD(J) = 1:G(J) = 1
430  NEXT J: GOTO 200
500  F = 0: FOR J = 1 TO N:F1 = 0: FOR Q = 0 TO 31: IF K(Q) = A(J) THEN F1 = 1
520  NEXT Q:F = F + (F1 = 0): NEXT J
540  IF F = 0 THEN 570
550  M$ = "키 없는 동작 있음. 저장할까요 (Y/N)?": GOSUB 1300: GOSUB 900
560  IF C < > 89 AND C < > 121 THEN M$ = "저장 안 함": GOTO 200
570  FOR J = 0 TO 31: POKE 768 + J,K(J): NEXT
575  HOME : PRINT
580  PRINT D$"BSAVE KEYS,A$300,L32"
590  PRINT : PRINT "저장했습니다. KEDIT 를 시작하면 이 키를 씁니다.": END
600  HOME : PRINT "모든 키를 처음 상태로:": PRINT
610  PRINT "1  기본 (KEDIT 의 키)"
620  PRINT "2  IJKL (^I 위 ^J 왼쪽 ^K 아래 ^L 오른쪽)"
630  PRINT "다른 키: 취소"
640  GOSUB 900
660  IF C = 49 THEN GOSUB 800:M$ = "기본 키로 바꿈"
670  IF C = 50 THEN GOSUB 820:M$ = "IJKL 키로 바꿈"
680  GOTO 180
750  KD(I) = 1:G(I) = 1: FOR J = 0 TO 31: IF K(J) = A(I) THEN K(J) = 0
760  NEXT J: RETURN
800  FOR J = 0 TO 31:K(J) = J: NEXT J: FOR J = 1 TO N:KD(J) = 1:G(J) = 1: NEXT J: RETURN
820  GOSUB 800:K(9) = 11:K(10) = 2:K(11) = 10:K(12) = 21:K(22) = 9:K(3) = 12:K(2) = 0: RETURN
900  REM WAIT FOR A KEY: C = ITS CODE. KEYS TYPED WHILE THE DRIVER DREW ARE IN ITS RING ($942B COUNT, $942C NEWEST, $95AE KEYS)
910  T =  PEEK (37931): IF T = 0 OR  PEEK (37932) > 31 THEN 940
920  T = T - 1: POKE 37931,T:X =  PEEK (37932) - T:X = X - 32 *  INT (X / 32)
930  C =  PEEK (38318 + X):C = C - 128 * (C > 127): RETURN
940  C =  PEEK ( - 16384): IF C < 128 THEN 910
950  POKE  - 16368,0:C = C - 128: RETURN
1010  REM STATE OF ENTRY J, NOT PRINTED: L = COLUMN, MK$ = MARK, KS$ = KEYS (6 CHARS), IV = INVERSE, Z$ = ALL OF IT, TO COMPARE WITH E$(J). THE KEY TEXT KC$(J) IS RECOMPUTED ONLY WHEN KD(J) IS SET (KEYS CHANGED), NOT ON A MOVE
1011  L = 23 * (J > 11): IF KD(J) THEN GOSUB 1100
1035  IV = ((J = W) + (KC$(J) = "-")) > 0: MK$ = " ": IF J = I THEN MK$ = ">"
1040  KS$ =  LEFT$ (KC$(J) + "      ",6): Z$ = MK$ + KS$ +  CHR$ (48 + IV): RETURN
1050  REM PRINT ENTRY J (STATE FROM 1010) AT THE CURRENT ROW; THE CALLER PLACES THE ROW. RECORD IT AS DRAWN
1051  POKE 36,L: IF IV THEN  INVERSE
1052  PRINT MK$;A$(J);: POKE 36,L + 16: PRINT KS$;: NORMAL : E$(J) = Z$:G(J) = 0: RETURN
1100  REM REBUILD THE KEY TEXT OF ALL ENTRIES IN ONE PASS OVER THE KEY MAP (AT START, AND AFTER A KEY CHANGE): KC$(J) = UP TO 3 KEYS, OR "-"
1101  FOR T9 = 0 TO 31: IX(T9) = 0: NEXT T9
1102  FOR T9 = 1 TO N: IX(A(T9)) = T9: KC$(T9) = "": NC(T9) = 0: NEXT T9
1103  FOR Q = 0 TO 31: T9 = IX(K(Q)): IF T9 = 0 THEN 1105
1104  IF NC(T9) < 3 THEN KC$(T9) = KC$(T9) + "^" +  CHR$ (64 + Q): NC(T9) = NC(T9) + 1
1105  NEXT Q
1106  FOR T9 = 1 TO N: KD(T9) = 0: IF KC$(T9) = "" THEN KC$(T9) = "-"
1107  NEXT T9: RETURN
1200  REM FULL SCREEN, FROM HOME, TOP TO BOTTOM (NO VTAB). ONLY AT START AND AFTER THE MENU, WHICH LEAVES ITS TEXT ON THE SCREEN
1210  HOME : PRINT "KEDIT 키 설정  (반전 = 키를 잃음)"
1215  FOR R = 1 TO 11:J = R: GOSUB 1010: GOSUB 1050:J = R + 11: IF J <= N THEN GOSUB 1010: GOSUB 1050
1220  PRINT : NEXT R
1230  PRINT M$:MS = (M$ <> ""):M$ = ""
1240  PRINT "컨트롤 키 = 이 동작에 붙임  ^U 다음  ^H 앞"
1250  PRINT "C 지움 R 처음으로 S 저장 Q 끝 I ^I 붙임"
1260  PRINT "고정: ^A ^H ^M ESC";: RETURN
1300  REM PARTIAL REDRAW: ONLY THE ENTRIES MARKED IN G (KEYS OR MARK CHANGED), THEN THE MESSAGE ROW
1310  FOR J = 1 TO N: IF G(J) THEN GOSUB 1400
1320  NEXT J
1330  IF M$ <> "" OR MS THEN GOSUB 1500
1340  M$ = "": RETURN
1400  REM ENTRY J: DRAW IT ONLY IF ITS STATE CHANGED. ROW IS SET WITH POKE 37 (CV), THE SAME ROW SEQUENTIAL PRINTING USES
1410  GOSUB 1010: G(J) = 0: IF Z$ = E$(J) THEN RETURN
1420  R = J - 11 * (J > 11): POKE 37,R: GOSUB 1050: RETURN
1500  REM MESSAGE ROW (SCREEN ROW 12): BLANK IT, THEN PRINT M$
1510  POKE 37,12: POKE 36,0: PRINT SP$;: POKE 36,0: PRINT M$;: MS = (M$ <> ""): RETURN
